<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The phone's player reads the muxed stream from PlaybackProxy.kt on this device, over plain HTTP
         (docs/streaming.md). Everything else keeps the default: HTTPS only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
